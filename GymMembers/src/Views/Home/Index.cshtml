@model IEnumerable<GymMembers.Models.GymMember>
@{
    ViewData["Title"] = "Gym Membership Demo";
    const string repo = "https://github.com/wizzard262/EntityFrameworkDotNetCoreMvcCodeFirstSqlGymMembership";
}

<header class="hero">
    <div class="wrap">
        <p class="eyebrow">C# .NET 10 &middot; EF Core Code First &middot; Azure SQL &middot; Terraform</p>
        <h1>Gym Membership</h1>
        <p class="lead">A C# MVC app that builds its SQL database from code with Entity Framework Code First migrations,
            fills it with test data and shows it here. Azure resources are created with Terraform and deployed by Azure DevOps.</p>
        <div class="hero-actions">
            <a class="button" href="@repo">View the code</a>
            <a class="button button-ghost" href="@repo/tree/main/GymMembers/infra">Terraform files</a>
        </div>
    </div>
</header>

<main class="wrap grid">
    <section class="card card-wide" aria-labelledby="members-title">
        <h2 id="members-title">Gym members and their classes</h2>
        <p class="muted small">Read live from the <code>GymMembership</code> Azure SQL database.</p>
        <div id="members" aria-live="polite">
            <div class="notice notice-warn">
                <span class="spinner" aria-hidden="true"></span>Loading members&hellip;
                The database is on Azure's free tier and goes to sleep when nobody uses it, so the first load can take up to a minute.
            </div>
        </div>
    </section>

    <section class="card" aria-labelledby="ef-title">
        <h2 id="ef-title">Code First migration</h2>
        <ul>
            <li>The <b>GymMember</b> and <b>ClassSession</b> models are C# classes.</li>
            <li>The <b>DbContext</b> sets up a many-to-many link: a member can attend many classes.</li>
            <li>Running the migration creates:
                <ul>
                    <li>the <b>GymMembership</b> database</li>
                    <li>the <b>GymMember</b> and <b>ClassSession</b> tables</li>
                    <li>the joining table <b>GymMemberClassSession</b></li>
                    <li>test data, such as <i>Alice Johnson</i> attending <i>Morning Yoga</i> and <i>HIIT Blast</i></li>
                </ul>
            </li>
        </ul>
    </section>

    <section class="card" aria-labelledby="tf-title">
        <h2 id="tf-title">Terraform deployment to Azure</h2>
        <ul>
            <li>Uses the existing resource group <b>ResourceGroup1</b>.</li>
            <li>Creates the App Service plan <b>asp-gym-membership-b1</b>.
                <span class="muted small">Terraform can't create a Free tier plan, so it was moved to Free in the portal.</span></li>
            <li>Creates the <b>GymMembership</b> database on the existing server <code>wizzard262.database.windows.net</code>.
                <span class="muted small">The free database also had to be set up in the portal.</span></li>
            <li>Creates the web app <b>gym-membership-webapp</b> and gives it a connection string called <b>DefaultConnection</b>.</li>
            <li>Sets <code>ASPNETCORE_ENVIRONMENT</code> to <b>Development</b>.</li>
        </ul>
    </section>

    <section class="card" aria-labelledby="ado-title">
        <h2 id="ado-title">Azure DevOps pipeline</h2>
        <p>Terraform makes the resources; a pipeline then deploys into them:</p>
        <ul>
            <li>the C# MVC app to the web app <b>gym-membership-webapp</b></li>
            <li>the database migrations (tables and data) to <b>GymMembership</b></li>
        </ul>
        <p><a href="@repo/blob/main/azure-pipelines.yml">See azure-pipelines.yml</a></p>
    </section>
</main>

@section Scripts {
    <script>
        // The free-tier database sleeps when unused: wake it with a tiny query, then load the members table
        async function loadMembers() {
            const box = document.getElementById("members");
            try {
                await fetch("/Home/WakeDatabase");
                const response = await fetch("/Home/GetMembers");
                if (!response.ok) throw new Error(response.status);
                box.innerHTML = await response.text();
            } catch (e) {
                box.innerHTML = '<div class="notice notice-bad">Couldn\'t load the members. The database may still be waking up: '
                    + '<a href="/">try again</a> in a minute.</div>';
            }
        }

        window.addEventListener("load", loadMembers);
    </script>
}
