@model IEnumerable<GymMembers.Models.GymMember>
<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Member</th>
            <th>Joined</th>
            <th>Classes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model)
        {
            <tr>
                <td>@member.FirstName @member.LastName</td>
                <td>@member.JoinDate.ToShortDateString()</td>
                <td>
                    @if (member.ClassSessions.Any())
                    {
                        <ul class="mb-0">
                            @foreach (var cls in member.ClassSessions)
                            {
                                <li>
                                    <strong>@cls.Name</strong>
                                    (@cls.StartTime.ToString("dd MMM yyyy HH:mm"))
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">No classes assigned</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>