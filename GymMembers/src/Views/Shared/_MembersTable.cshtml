@model IEnumerable<GymMembers.Models.GymMember>
<div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Member</th>
                <th>Joined</th>
                <th>Classes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in Model)
            {
                <tr>
                    <td data-label="Member"><b>@member.FirstName @member.LastName</b></td>
                    <td data-label="Joined">@member.JoinDate.ToString("d MMM yyyy")</td>
                    <td data-label="Classes">
                        @if (member.ClassSessions.Any())
                        {
                            <div>
                                @foreach (var cls in member.ClassSessions.OrderBy(c => c.StartTime))
                                {
                                    <span class="chip">@cls.Name &middot; @cls.StartTime.ToString("d MMM HH:mm")</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="muted">No classes</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<p class="muted small">@Model.Count() members, @Model.SelectMany(m => m.ClassSessions).Select(c => c.Name).Distinct().Count() different classes.</p>
