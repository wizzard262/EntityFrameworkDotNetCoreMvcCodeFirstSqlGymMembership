<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@(ViewData["Title"] ?? "Gym Membership Demo")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()

    <footer class="footer">
        <div class="wrap">
            Gym Membership demo by Steve Jones &middot;
            <a href="https://github.com/wizzard262/EntityFrameworkDotNetCoreMvcCodeFirstSqlGymMembership">Code on GitHub</a> &middot;
            <a href="https://www.harriercarrier.com/portfolio.html">Portfolio</a>
        </div>
