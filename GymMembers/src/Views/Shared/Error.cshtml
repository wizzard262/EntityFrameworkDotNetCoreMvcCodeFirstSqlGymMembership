@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<header class="hero">
    <div class="wrap">
        <p class="eyebrow">Gym Membership</p>
        <h1>Something went wrong</h1>
        <p class="lead">The page couldn't be shown. The database may be waking up: try again in a minute.</p>
        <div class="hero-actions">
            <a class="button" href="/">Back to the home page</a>
        </div>
    </div>
</header>

<main class="wrap grid">
    <section class="card card-wide">
        @if (Model.ShowRequestId)
        {
            <p><b>Request ID:</b> <code>@Model.RequestId</code></p>
        }
        <p class="muted small">Running in the <b>Development</b> environment shows the full error, which is useful locally but should not be used on a live site.</p>
    </section>
</main>
